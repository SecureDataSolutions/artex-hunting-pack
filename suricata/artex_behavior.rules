# ARTEX / agentic-attack behavioral hunting rules (TLP:CLEAR)
# These are hunting-grade, not blocking-grade. Tune $HOME_NET / $HTTP_SERVERS and expect some noise.
# Local SID range 9261001-9261999.

# --- Inbound: agentic scanners against YOUR web servers ---------------------------------
# Microsoft reports ARTEX drives Nmap, curl, wget, Python HTTP clients and headless Chromium (Playwright).
# Default UAs from those tools hitting public apps are a cheap early signal.
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ARTEX-HUNT inbound HeadlessChrome UA (Playwright-style agent browsing)"; flow:established,to_server; http.user_agent; content:"HeadlessChrome"; nocase; threshold:type both, track by_src, count 20, seconds 60; classtype:attempted-recon; metadata:created_at 2026_11_08, tlp clear; sid:9261001; rev:1;)
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ARTEX-HUNT inbound python-requests/urllib burst"; flow:established,to_server; http.user_agent; pcre:"/^python-(requests|urllib)/i"; threshold:type both, track by_src, count 50, seconds 60; classtype:attempted-recon; metadata:created_at 2026_11_08, tlp clear; sid:9261002; rev:1;)
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ARTEX-HUNT inbound Nmap scripting engine UA"; flow:established,to_server; http.user_agent; content:"Nmap Scripting Engine"; nocase; threshold:type limit, track by_src, count 1, seconds 600; classtype:attempted-recon; metadata:created_at 2026_11_08, tlp clear; sid:9261003; rev:1;)
# Wiz/SOC Prime describe ARTEX recon hitting API docs early. High 404 rate + docs probing from one source = agent sweep.
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ARTEX-HUNT inbound API-doc discovery sweep (swagger/openapi)"; flow:established,to_server; http.uri; pcre:"/\/(swagger(-ui)?|openapi|api-docs|v[0-9]\/api-docs)(\.json|\.yaml|\/|$)/i"; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-recon; metadata:created_at 2026_11_08, tlp clear; sid:9261004; rev:1;)

# --- Outbound: post-exploitation tradecraft Microsoft saw ARTEX agents use -----------------
# Storm-3358 agents used curl / netcat to pull WISP, vshell and AdaptixC2 onto compromised Linux web servers.
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ARTEX-HUNT server curl/wget fetching ELF from external host"; flow:established,to_client; file.data; content:"|7F 45 4C 46|"; startswith; flowbits:isset,artex.cli_ua; classtype:trojan-activity; metadata:created_at 2026_11_08, tlp clear; sid:9261010; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ARTEX-HUNT set flowbit: CLI download UA from internal host"; flow:established,to_server; http.user_agent; pcre:"/^(curl|wget|python-requests|python-urllib)/i"; flowbits:set,artex.cli_ua; flowbits:noalert; sid:9261011; rev:1;)
# Direct-to-IP HTTP GET for a file with a binary/script extension from a server segment.
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ARTEX-HUNT direct-to-IP download of binary/script"; flow:established,to_server; http.method; content:"GET"; http.host; pcre:"/^\d{1,3}(\.\d{1,3}){3}(:\d+)?$/"; http.uri; pcre:"/\.(sh|elf|bin|exe|dll|so|py)(\?|$)/i"; classtype:trojan-activity; metadata:created_at 2026_11_08, tlp clear; sid:9261012; rev:1;)

# --- Outbound: LLM API egress from servers that shouldn't talk to LLMs ----------------------
# If an attacker lands an agent *inside* (or a host is used as a relay), LLM API calls from a
# DB/app server are odd. Scope $HOME_NET here to server subnets only, or this fires on laptops.
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ARTEX-HUNT LLM API egress (DeepSeek/Zhipu/reseller) from server segment"; flow:established,to_server; tls.sni; pcre:"/(^|\.)(api\.deepseek\.com|open\.bigmodel\.cn|xcai\.pro)$/i"; threshold:type limit, track by_src, count 1, seconds 3600; classtype:policy-violation; metadata:created_at 2026_11_08, tlp clear; sid:9261020; rev:1;)
